# ============================================================
# Emperor — Environment Template
# Copy this to .env and fill in your values.
# ============================================================

# ── API Key Files ────────────────────────────────────────────
# Point each variable to the text file containing that API key.
# The file should contain just the raw key string, nothing else.
#
# Alternatively, on Linux/Mac/CI you can skip the file approach
# and export the keys directly as env vars with the same names
# but with _FILE removed, then update config.py accordingly.

GOOGLE_API_KEY_FILE=/path/to/google_api_key.txt
NVIDIA_API_KEY_FILE=/path/to/nvidia_api_key.txt
LINKUP_API_KEY_FILE=/path/to/linkup_api_key.txt
CLOUDFLARE_API_KEY_FILE=/path/to/cloudflare_api_key.txt
TOKEN_ROUTER_API_KEY_FILE=/path/to/tokenrouter_api_key.txt
SEMANTIC_SCHOLAR_API_KEY_FILE=/path/to/semantic_scholar_api_key.txt  # free key at semanticscholar.org/product/api
MISTRAL_API_KEY_FILE=/path/to/tokenrouter_api_key.txt # required only for workspace_search semantic=true (Codestral Embed)

# ── Cloudflare Account ───────────────────────────────────────
# Find this in your Cloudflare dashboard under "Account Home"
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ── Global History ────────────────────────────────────────────
# Cross-project chat history folder. All Emperor projects write
# to this shared location so search_history works across projects.
# Can be any folder you choose. Will be created automatically.
GLOBAL_HISTORIES_DIR=/path/to/your/shared/chat_histories

# ── Local Backend (llama.cpp / llama-server) ─────────────────
# Configure your local model and endpoint.
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=gemma-4-26B-A4B-it-qat-UD-Q4_K_XL
LOCAL_API_KEY_FILE=either add or skip
